# Postgres connection (Railway provides DATABASE_URL automatically when you add Postgres)
DATABASE_URL=postgres://user:pass@localhost:5432/vtnebuddy

# Public URL of the site, used in email links (no trailing slash)
APP_URL=https://vettechstudybuddy.com

# Email sending via SendGrid. Leave SENDGRID_API_KEY empty to run in dry-run mode (emails are logged, not sent).
SENDGRID_API_KEY=
EMAIL_FROM=hello@vettechstudybuddy.com
EMAIL_FROM_NAME=Sara at Vet Tech Study Buddy
EMAIL_REPLY_TO=hello@vettechstudybuddy.com

# Required by CAN-SPAM in every marketing email footer
POSTAL_ADDRESS=

# Secrets: long random strings
CRON_SECRET=change-me
# Emails of owner accounts that can open /admin (comma-separated). They sign in with their own password.
OWNER_EMAILS=hello@vettechstudybuddy.com

# Voice study buddy (ElevenLabs agent "Sara - Vet Tech Study Buddy")
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_9401m7ngg5ezfm8bm413a579rmz0
VOICE_SESSIONS_PER_DAY=3

# Payments (Stripe). Leave blank and the pricing page shows "Coming soon".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Founding price applies to the first N Exam Passes sold.
FOUNDING_LIMIT=100
# Practice questions per day on a free account.
FREE_DAILY_PRACTICE=10
